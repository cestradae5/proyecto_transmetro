                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idEstacion\": {{idEstacion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"5 minutos extra solo bajo el 25%\", () => {",
                  "  const expected = body.ocupacionEstimada < body.capacidadPasajeros * 0.25 ? 5 : 0;",
                  "  pm.expect(body.minutosEsperaExtra).to.eql(expected);",
                  "});",
                  "pm.test(\"nunca supera la capacidad\", () => pm.expect(body.ocupacionEstimada).to.be.at.most(body.capacidadPasajeros));"
                ]
              }
            }
          ]
        },
