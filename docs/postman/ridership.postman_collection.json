            "body": {
              "mode": "raw",
              "raw": "{\n  \"bajaron\": -1,\n  \"subieron\": 1.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Leer unidad (operación central)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/ridership/units/{{idUnidad}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "ridership",
                "units",
                "{{idUnidad}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
