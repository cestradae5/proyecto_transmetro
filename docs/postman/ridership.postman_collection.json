    {
      "name": "3. Alertas de capacidad",
      "item": [
        {
          "name": "Listar alertas de capacidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/ridership/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "ridership",
                "alerts"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const open = list.find((a) => a.parada.idParada === String(pm.collectionVariables.get(\"idParada\")) && a.estadoAlerta !== \"RESUELTA\");",
                  "if (open) pm.collectionVariables.set(\"idAlerta\", open.idAlerta);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolver alerta (central)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/operations/alerts/central/{{idAlerta}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "alerts",
                "central",
                "{{idAlerta}}",
                "status"
              ]
            },
            "description": "Después de resolverla, la siguiente entrada por encima del 150% genera una alerta nueva.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"RESUELTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 sin autor (alerta del sistema)\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().autor).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Bus (piloto)",
      "description": "El bus solo traslada pasajeros. El piloto marca su parada actual y reporta cuántos bajaron y subieron. Usa {{tokenPiloto}} (un usuario PILOTO con unidad asignada).",
      "item": [
        {
          "name": "1. Marcar parada actual",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fleet/units/my-unit/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fleet",
                "units",
                "my-unit",
                "location"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPiloto}}",
                  "type": "string"
                }
              ]
            },
            "description": "idLineaParada: posición de la parada en la línea de la unidad (GET /fleet/units/my-unit/stops).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idLineaParada\": {{idLineaParada}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Leer mi unidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/ridership/my-unit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "ridership",
                "my-unit"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPiloto}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"aBordoAntes\", body.aBordo);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Reportar pasajeros",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/operations/ridership/my-unit/stop-report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "ridership",
                "my-unit",
                "stop-report"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPiloto}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bajaron\": 0,\n  \"subieron\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const before = Number(pm.collectionVariables.get(\"aBordoAntes\"));",
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"a bordo = antes - bajaron + subieron\", () => {",
                  "  if (!Number.isNaN(before)) pm.expect(body.aBordo).to.eql(before - body.bajaron + body.subieron);",
                  "});",
                  "pm.test(\"5 minutos extra solo bajo el 25%\", () => {",
                  "  pm.expect(body.minutosEsperaExtra).to.eql(body.porcentaje < 25 ? 5 : 0);",
                  "});",
                  "pm.collectionVariables.set(\"aBordoAntes\", body.aBordo);"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: bajan más de los que van a bordo (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
