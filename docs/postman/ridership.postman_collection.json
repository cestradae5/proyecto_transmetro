    {
      "name": "3. Alertas de capacidad",
      "item": [
        {
          "name": "Listar alertas de capacidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/ridership/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "ridership",
                "alerts"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const open = list.find((a) => a.estacion.idEstacion === String(pm.collectionVariables.get(\"idEstacion\")) && a.estadoAlerta !== \"RESUELTA\");",
                  "if (open) pm.collectionVariables.set(\"idAlerta\", open.idAlerta);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolver alerta (central)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/operations/alerts/central/{{idAlerta}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "alerts",
                "central",
                "{{idAlerta}}",
                "status"
              ]
            },
            "description": "Después de resolverla, la siguiente entrada por encima del 150% genera una alerta nueva.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"RESUELTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 sin autor (alerta del sistema)\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().autor).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
