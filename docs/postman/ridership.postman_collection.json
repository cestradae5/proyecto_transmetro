{
  "info": {
    "name": "Transmetro - Conteo de pasajeros (ridership)",
    "description": "Talanquera, alerta de capacidad de estación (150%) y regla del bus bajo 25%. Guía: docs/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Estación",
      "item": [
        {
          "name": "1. Fijar capacidad de la estación (4)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/infrastructure/estaciones/{{idEstacion}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "infrastructure",
                "estaciones",
                "{{idEstacion}}"
              ]
            },
            "description": "Con capacidad 4, la alerta salta al llegar a 6 personas (150%).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacidadPasajeros\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 y capacidad 4\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().capacidadPasajeros).to.eql(4);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Leer ocupación de la estación",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/ridership/stations/{{idEstacion}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "ridership",
                "stations",
                "{{idEstacion}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"alertaActiva coherente con el 150%\", () => {",
                  "  if (body.personasEnEstacion >= body.capacidadPasajeros * 1.5) pm.expect(body.alertaActiva).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set(\"personasAntes\", body.personasEnEstacion);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Talanquera",
      "item": [
        {
          "name": "Entrada (cobra Q1.00)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Turnstile-Key",
                "value": "{{turnstileKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/operations/ridership/turnstile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "ridership",
                "turnstile"
              ]
            },
            "description": "Mandala varias veces: con capacidad 4, la 6.ª persona genera la alerta (alertaGenerada: true).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroTarjeta\": \"{{tarjeta}}\",\n  \"idEstacion\": {{idEstacion}},\n  \"tipo\": \"ENTRADA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const before = Number(pm.collectionVariables.get(\"personasAntes\"));",
                  "pm.test(\"201 y cobra Q1.00\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.montoCobrado).to.eql(1);",
                  "});",
                  "pm.test(\"suma una persona a la estación\", () => {",
                  "  if (!Number.isNaN(before)) pm.expect(body.estacion.personasEnEstacion).to.eql(before + 1);",
                  "});",
                  "pm.test(\"al 150% hay alerta activa\", () => {",
                  "  const limit = body.estacion.capacidadPasajeros * 1.5;",
                  "  if (body.estacion.personasEnEstacion >= limit) pm.expect(body.estacion.alertaActiva).to.eql(true);",
                  "  else pm.expect(body.alertaGenerada).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set(\"personasAntes\", body.estacion.personasEnEstacion);",
                  "pm.collectionVariables.set(\"saldo\", body.saldo);"
                ]
              }
            }
          ]
        },
        {
          "name": "Salida (no cobra)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Turnstile-Key",
                "value": "{{turnstileKey}}"
