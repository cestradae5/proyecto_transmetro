            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroTarjeta\": \"{{tarjeta}}\",\n  \"idEstacion\": {{idEstacion}},\n  \"tipo\": \"SALIDA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"201 sin cobro\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.montoCobrado).to.eql(0);",
                  "});",
                  "pm.test(\"no cambia las personas esperando\", () => {",
                  "  const before = Number(pm.collectionVariables.get(\"personasAntes\"));",
                  "  if (!Number.isNaN(before)) pm.expect(body.estacion.personasEnEstacion).to.eql(before);",
                  "});"
                ]
              }
            }
          ]
        },
