NODE_ENV=development
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=transmetro
DATABASE_USER=transmetro
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Turnstile simulator (operations/ridership). The endpoint answers 404 unless
# the flag is exactly "true"; requests need X-Turnstile-Key equal to the key.
TURNSTILE_SIMULATOR_ENABLED=false
TURNSTILE_API_KEY=change-me

# Simulated recharges for apps/user-web (citizen module). No real payment:
# keep it "false" in production.
RECHARGE_SIMULATOR_ENABLED=false

# Demo role switch for academic review (docs/demo-role-switch.md). The
# endpoints answer 404 unless the flag is "true" AND the allowlist is set.
DEMO_ROLE_SWITCH_ENABLED=false
DEMO_ROLE_SWITCH_EMAILS=
