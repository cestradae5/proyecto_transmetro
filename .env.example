NODE_ENV=development
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=transmetro
DATABASE_USER=transmetro
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Turnstile simulator (operations/ridership). The endpoint answers 404 unless
# the flag is exactly "true"; requests need X-Turnstile-Key equal to the key.
TURNSTILE_SIMULATOR_ENABLED=false
TURNSTILE_API_KEY=change-me
