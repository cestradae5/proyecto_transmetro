{
  "name": "@transmetro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.json",
    "migration:generate": "typeorm-ts-node-esm migration:generate src/platform/database/migrations/migration -d src/platform/database/data-source.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/platform/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/platform/database/data-source.ts",
    "migration:show": "typeorm-ts-node-esm migration:show -d src/platform/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.2",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@nestjs/typeorm": "12.0.1",
    "dotenv": "17.2.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.1",
    "@nestjs/testing": "12.0.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.5.1",
    "@types/supertest": "7.2.1",
    "cross-env": "10.1.0",
    "jest": "30.5.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
